# ==============================================================================
# CareSync — Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' for local development. Never commit real credentials.
# In production, provide these via server environment variables.
# ==============================================================================

# Database Configuration (Neon Cloud PostgreSQL)
DB_HOST=your-neon-endpoint.neon.tech
DB_PORT=5432
DB_NAME=caresync_db
DB_USER=caresync_app
DB_PASSWORD=your_secure_password_here
DB_SSLMODE=require

# HikariCP Connection Pool (Configured for Neon Serverless Scale-to-Zero)
DB_POOL_MIN_IDLE=0
DB_POOL_MAX_SIZE=10
DB_POOL_IDLE_TIMEOUT_MS=600000
DB_POOL_MAX_LIFETIME_MS=1800000
DB_POOL_CONN_TIMEOUT_MS=30000

# Authentication & Security
AUTH_PBKDF2_ITERATIONS=600000
SESSION_TIMEOUT_MINUTES=30
COOKIE_SECURE=false

# Application
APP_ENV=development
APP_BASE_URL=http://localhost:8080/caresync

